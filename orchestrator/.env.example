# Kopieren nach .env und mit echten Werten aus dem ai-lab-Netzwerk fuellen.

# LiteLLM (siehe Sektion 3/4.6 der Projektspezifikation) - der EINZIGE
# LLM-Zugang; LM Studio haengt als Provider dahinter.
LITELLM_BASE_URL=http://litellm:4000
LITELLM_API_KEY=sk-changeme
# Fallback-Modell, solange im Admin-Panel keins aktiviert wurde.
LITELLM_MODEL=gemma-4-e4b

# Weaviate (Sektion 4.8/4.9) - nur REST-Port noetig, kein gRPC (siehe Begruendung in weaviate_client.py)
WEAVIATE_URL=http://weaviate:8080
WEAVIATE_API_KEY=
WEAVIATE_CONTENT_PROPERTY=content
RAG_TOP_K=5
RAG_RELATIVE_MARGIN=0.05

# Voice-Pipeline (Mikro-Phasen 1.8-1.11); Defaults = Compose-Service-Namen
STT_BASE_URL=http://stt:8000
PIPER_BASE_URL=http://tts-piper:8000
XTTS_BASE_URL=http://tts-xtts:8000
TARGET_SAMPLE_RATE=24000
INPUT_SAMPLE_RATE=16000
FILLER_ENABLED=true
FILLER_DELAY_MS=1200
DEFAULT_VOICE_ID=default-de-female

# Persistenz (1.7b/1.7d): SQLite + Voice-Samples + Filler-Audio-Cache
DATABASE_PATH=/data/heimai.db
VOICES_DIR=/voices
FILLER_CACHE_DIR=/data/filler-cache

# Seed-Admin: wird nur beim allerersten Start in die leere DB geschrieben.
# Danach User-Verwaltung ueber das Admin-Panel (/admin). Passwort-Aenderung
# hier wirkt NICHT nachtraeglich - dafuer das Panel nutzen.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
JWT_SECRET=changeme-dev-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
