# Kopieren nach .env und mit echten Werten aus dem ai-lab-Netzwerk fuellen.

# LiteLLM (siehe Sektion 3/4.6 der Projektspezifikation)
LITELLM_BASE_URL=http://litellm:4000
LITELLM_API_KEY=sk-changeme
LITELLM_MODEL=gemma-4-e4b

# Weaviate (Sektion 4.8/4.9) - nur REST-Port noetig, kein gRPC (siehe Begruendung in weaviate_client.py)
WEAVIATE_URL=http://weaviate:8080
WEAVIATE_API_KEY=
WEAVIATE_CONTENT_PROPERTY=content
RAG_TOP_K=5
RAG_RELATIVE_MARGIN=0.05

# Voice-Pipeline (Mikro-Phasen 1.8-1.11); Defaults = Compose-Service-Namen
STT_BASE_URL=http://stt:8000
PIPER_BASE_URL=http://tts-piper:8000
XTTS_BASE_URL=http://tts-xtts:8000
TARGET_SAMPLE_RATE=24000
INPUT_SAMPLE_RATE=16000
FILLER_ENABLED=true
FILLER_DELAY_MS=1200
DEFAULT_VOICE_ID=default-de-female

# Auth-Stub vor Mikro-Phase 1.7b (einziger Admin-User aus Config)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
JWT_SECRET=changeme-dev-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
